# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:root@localhost:5432/lighthouse_monitoring"

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Groq API key for AI summary generation (required)
# Get your key at: https://console.groq.com
GROQ_API_KEY="gsk_..."

# ── Audit Schedule ────────────────────────────────────────────────────────────
# Cron expression for the weekly audit schedule (informational — configured in GitHub Actions)
# Default: every Monday at 06:00 UTC
AUDIT_SCHEDULE="0 6 * * 1"

# ── Report Output ─────────────────────────────────────────────────────────────
# Directory where JSON (and optionally Markdown) reports are written (required)
# The directory will be created automatically if it does not exist
REPORT_OUTPUT_DIR="./reports"

# Set to 'true' to also generate a human-readable Markdown report alongside JSON
# Default: false
MARKDOWN_OUTPUT_ENABLED="false"

# ── Email Notification (SMTP) ─────────────────────────────────────────────────
# SMTP username for sending email notifications (required)
# Usually your full email address (e.g., alerts@yourdomain.com)
SMTP_USER="your_email@example.com"

# SMTP password or application-specific password (required)
# For security, use an App Password if using Gmail or Outlook
SMTP_PASS="your_secure_password"

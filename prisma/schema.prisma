generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Environment {
  Production
  Staging
}

model Project {
  id          String      @id @default(cuid())
  title       String
  description String?
  owner       String
  priority    String      @default("medium")
  environment Environment
  reportEmail String?     @map("report_email")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  urls        ProjectUrl[]
  auditRuns   AuditRun[]
  weeklyIntelligenceSnapshots WeeklyIntelligenceSnapshot[]

  @@map("projects")
}

model ProjectUrl {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  pageType  String   @map("page_type")
  url       String
  priority  String   @default("medium")
  createdAt DateTime @default(now()) @map("created_at")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditRuns AuditRun[]
  weeklyIntelligenceSnapshots WeeklyIntelligenceSnapshot[]

  @@map("project_urls")
}

model AuditRun {
  id                  String   @id @default(cuid())
  projectId           String   @map("project_id")
  projectUrlId        String   @map("project_url_id")
  status              String   @default("success")
  performanceScore    Float?   @map("performance_score")
  accessibilityScore  Float?   @map("accessibility_score")
  seoScore            Float?   @map("seo_score")
  bestPracticesScore  Float?   @map("best_practices_score")
  lcp                 Float?
  cls                 Float?
  inpOrTbt            Float?   @map("inp_or_tbt")
  fcp                 Float?
  speedIndex          Float?   @map("speed_index")
  ttfb                Float?   @map("ttfb")
  opportunitiesJson   Json?    @map("opportunities_json")
  aiSummary           String?  @map("ai_summary")
  agentPromptsJson    Json?    @map("agent_prompts_json")
  createdAt           DateTime @default(now()) @map("created_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectUrl ProjectUrl @relation(fields: [projectUrlId], references: [id], onDelete: Cascade)

  @@map("audit_runs")
}

model WeeklyIntelligenceSnapshot {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  projectUrlId     String   @map("project_url_id")
  latestRunId      String   @map("latest_run_id")
  previousRunId    String   @map("previous_run_id")
  metricsJson      Json     @map("metrics_json")
  regressionsJson  Json     @map("regressions_json")
  improvementsJson Json     @map("improvements_json")
  aiInsight        String?  @map("ai_insight")
  createdAt        DateTime @default(now()) @map("created_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectUrl ProjectUrl @relation(fields: [projectUrlId], references: [id], onDelete: Cascade)

  @@unique([projectUrlId, latestRunId, previousRunId])
  @@map("weekly_intelligence_snapshots")
}
